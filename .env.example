# ─── Frontend (públicas, se incluyen en el bundle) ───────────────────
# Solo la URL del proyecto y la anon key. La anon key es pública por diseño:
# la seguridad real la dan Supabase Auth + las políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Servidor (SOLO en Netlify → Site settings → Environment variables) ──
# Nunca con prefijo VITE_. Nunca se envían al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Integraciones futuras (dejar vacías hasta configurarlas)
AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_VIDEO_PROVIDER=
AI_VIDEO_API_KEY=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Fase 2 · Automatización (solo en Netlify → Environment variables) ──
# AI_TEXT_PROVIDER=anthropic
# AI_TEXT_API_KEY=        (clave de console.anthropic.com)
# PEXELS_API_KEY=         (clave gratuita de pexels.com/api)
